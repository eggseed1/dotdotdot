{
  "name": "larper101",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/check-fallback.mjs && vitest run src/lib/engine.test.ts src/lib/sharing.test.ts && node --test server/*.test.mjs src/lib/title-match.test.mjs src/lib/rarity-model.test.mjs && npm run test:catalog-pipelines && npm run test:discogs",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test:duel": "node --test server/*.test.mjs",
    "import:catalog": "node scripts/import-catalog.mjs",
    "fetch:musicbrainz": "node scripts/fetch-musicbrainz.mjs",
    "fetch:wikidata": "node scripts/fetch-wikidata.mjs",
    "import:books": "node scripts/import-openlibrary-dump.mjs",
    "import:imdb": "node scripts/import-imdb-dump.mjs",
    "test:bulk": "node --test scripts/import-imdb-dump.test.mjs",
    "import:musicbrainz-core": "node scripts/import-musicbrainz-core.mjs",
    "fetch:anilist": "node scripts/fetch-anilist.mjs",
    "fetch:tmdb": "node scripts/fetch-tmdb.mjs",
    "fetch:igdb": "node scripts/fetch-igdb.mjs",
    "test:catalog-pipelines": "node --test scripts/import-musicbrainz-core.test.mjs scripts/fetch-anilist.test.mjs scripts/fetch-tmdb.test.mjs scripts/fetch-igdb.test.mjs",
    "test:discogs": "python3 -m unittest discover -s scripts -p 'test_import_discogs*.py' && python3 -m unittest discover -s scripts -p 'test_import_openlibrary_online.py'",
    "import:discogs": "python3 scripts/import-discogs-dump.py",
    "import:discogs:full": "python3 scripts/import-discogs-online.py",
    "import:books:full": "python3 scripts/import-openlibrary-online.py",
    "catalog:bootstrap": "node scripts/catalog-bootstrap.mjs",
    "catalog:audit": "node scripts/catalog-audit.mjs",
    "catalog:restore": "node scripts/restore-catalog.mjs",
    "catalog:snapshot": "node scripts/catalog-snapshot.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vitest": "^2.1.8",
    "@types/ws": "^8.5.14"
  }
}
